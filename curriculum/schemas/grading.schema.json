{"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["assessment", "review_status", "mode", "passing_score", "max_score", "estimated_minutes"], "properties": {"assessment": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "review_status": {"enum": ["draft", "reviewed"]}, "mode": {"enum": ["rules", "ai"]}, "passing_score": {"type": "integer", "minimum": 0, "maximum": 100}, "max_score": {"type": "integer", "exclusiveMinimum": 0}, "estimated_minutes": {"type": "integer", "exclusiveMinimum": 0}, "questions": {"type": "array", "items": {"type": "object", "required": ["id", "prompt", "options"], "properties": {"id": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}, "options": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["value", "label"], "properties": {"value": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false}}, "answer_key": {"type": "object"}, "rubric": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "weight"], "properties": {"criterion": {"type": "string", "minLength": 1}, "weight": {"type": "integer", "exclusiveMinimum": 0}}, "additionalProperties": false}}}, "additionalProperties": false}