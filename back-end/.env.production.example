# Copy to the deployment's secret/environment manager; never commit populated credentials.
APP_ENV=production
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
PUBLIC_WEB_URL=https://app.example.com

# Choose providers deliberately: mock is a simulator; openai/http require real credentials/endpoints.
AI_PROVIDER=
BLOCKCHAIN_PROVIDER=
OPENAI_API_KEY=
AI_ALLOW_MOCK_FALLBACK=False
BLOCKCHAIN_SERVICE_URL=
BLOCKCHAIN_SERVICE_TOKEN=

# Database and Redis are internal to docker-compose.hosted.yml.
DB_NAME=progressio_db
DB_USER=progressio
DB_PASSWORD=

# Set True only when the trusted reverse proxy strips client supplied X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False

# Email is disabled until the product uses email. For SMTP, set ENABLE_EMAIL=True
# and provide EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, and optional EMAIL_PORT.
ENABLE_EMAIL=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Progressio <noreply@example.com>
