APP_ENV=local
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:3000

# Database (PostgreSQL)
DB_NAME=progressio_db
DB_USER=progressio
DB_PASSWORD=your_password_here
DB_HOST=db
DB_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Request budgets. Hosted instances should use the same Redis URL and prefix.
# With a Redis broker, the throttle cache reuses the broker unless overridden.
THROTTLE_CACHE_URL=redis://redis:6379/1
THROTTLE_CACHE_KEY_PREFIX=progressio
TRUSTED_PROXY_COUNT=0
# Per-scope defaults and tuning guidance are in THROTTLING.md.
# THROTTLE_RATE_AUTH_REGISTER=60/hour
# THROTTLE_RATE_AUTH_LOGIN=10/min
# THROTTLE_RATE_AUTH_LOGIN_IP=60/min
# THROTTLE_RATE_AUTH_REFRESH=30/min
# THROTTLE_RATE_ASSESSMENT_SUBMIT=30/hour
# THROTTLE_RATE_AI=20/hour
# THROTTLE_RATE_CREDENTIAL_ISSUE=10/hour
# THROTTLE_RATE_PUBLIC_VERIFY=60/min

# AI Provider (mock | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45
# Set True only when a demo should remain available during an OpenAI outage.
AI_ALLOW_MOCK_FALLBACK=False

# Blockchain adapter (mock for local demos, http for an external on-chain signer service)
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_SERVICE_URL=
BLOCKCHAIN_SERVICE_TOKEN=
BLOCKCHAIN_TIMEOUT_SECONDS=30

# Email (Console for development — switch to SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
