APP_ENV=local
DB_ENGINE=postgresql
DB_NAME=progressio_demo
DB_USER=progressio_demo
DB_PASSWORD=
SECRET_KEY=

# Set GROQ_API_KEY in this ignored local file to enable the live AI demo.
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=10
AI_MAX_COMPLETION_TOKENS=2048
AI_ALLOW_MOCK_FALLBACK=False

BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_NETWORK=base-sepolia
DEMO_BLOCKCHAIN_RPC_URL=https://sepolia.base.org
DEMO_ANCHOR_SIGNER_ADDRESS=
DEMO_ANCHOR_MAX_FEE_GWEI=10
