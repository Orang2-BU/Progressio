{"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["id", "title", "provider", "type", "role", "url", "difficulty", "supported_skills", "authority_level", "verified_at", "estimated_minutes", "license", "license_url", "license_verified", "redistributable", "attribution_required", "commercial_use_allowed"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "title": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "type": {"enum": ["documentation", "standard", "tutorial", "article", "exercise", "reference"]}, "role": {"enum": ["primary", "reference", "practice", "supplementary"]}, "url": {"type": "string", "format": "uri"}, "difficulty": {"enum": ["Beginner", "Intermediate", "Advanced"]}, "supported_skills": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "authority_level": {"type": "string", "minLength": 1}, "verified_at": {"type": "string", "format": "date"}, "estimated_minutes": {"type": ["integer", "null"], "exclusiveMinimum": 0}, "license": {"type": "string", "minLength": 1}, "license_url": {"type": "string", "format": "uri"}, "license_verified": {"type": "boolean"}, "redistributable": {"type": "boolean"}, "attribution_required": {"type": "boolean"}, "commercial_use_allowed": {"type": "boolean"}}, "additionalProperties": false}