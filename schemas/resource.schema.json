{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "provider", "type", "role", "url", "difficulty", "supported_skills", "authority_level", "verified_at", "why_selected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "type": {"enum": ["documentation", "standard", "tutorial", "article", "exercise", "reference"]},
          "role": {"enum": ["primary", "reference", "practice"]},
          "url": {"type": "string", "format": "uri"},
          "difficulty": {"enum": ["Beginner", "Intermediate", "Advanced"]},
          "supported_skills": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "authority_level": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date"},
          "why_selected": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
