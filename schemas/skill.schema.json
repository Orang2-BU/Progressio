{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "competency", "description", "difficulty", "estimated_learning_hours", "learning_outcomes", "prerequisites", "why_it_matters", "resources", "assessments", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1},
          "competency": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "difficulty": {"enum": ["Beginner", "Intermediate", "Advanced"]},
          "estimated_learning_hours": {"type": "number", "exclusiveMinimum": 0},
          "learning_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "why_it_matters": {"type": "string", "minLength": 1},
          "resources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assessments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
