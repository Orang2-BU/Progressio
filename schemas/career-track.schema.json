{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "version", "status", "estimated_learning_hours", "tags", "competencies"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "minLength": 1},
    "estimated_learning_hours": {"type": "number", "exclusiveMinimum": 0},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "competencies": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}}
  },
  "additionalProperties": false
}
