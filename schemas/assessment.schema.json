{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "type", "objective", "expected_evidence", "mastery_criteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "skill": {"type": "string"},
          "type": {"enum": ["quiz", "coding-challenge", "debugging-task", "practical-exercise", "mini-project"]},
          "objective": {"type": "string", "minLength": 1},
          "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "mastery_criteria": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
